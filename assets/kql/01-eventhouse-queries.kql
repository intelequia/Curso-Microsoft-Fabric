// ============================================================================
// Aurora Energía · Consultas KQL para Eventhouse de telemetría
// Tabla: telemetria_surtidores  (timestamp, estacion_id, surtidor_id, evento, valor, severidad)
// ============================================================================

// 1. Eventos de las últimas 24 horas por severidad
telemetria_surtidores
| where timestamp > ago(24h)
| summarize total = count() by severidad
| order by total desc

// 2. Top 10 estaciones con más errores en la última semana
telemetria_surtidores
| where timestamp > ago(7d) and severidad == "error"
| summarize errores = count() by estacion_id
| top 10 by errores desc

// 3. Caudal medio por surtidor en intervalos de 5 minutos
telemetria_surtidores
| where evento == "caudal" and timestamp > ago(1d)
| summarize avg_caudal = avg(valor) by bin(timestamp, 5m), surtidor_id
| order by timestamp asc

// 4. Detección de anomalías de caudal con make-series + series_decompose_anomalies
telemetria_surtidores
| where evento == "caudal" and timestamp > ago(7d)
| make-series caudal_avg = avg(valor) on timestamp step 1h by surtidor_id
| extend (anomalies, score, baseline) =
        series_decompose_anomalies(caudal_avg, 1.5, -1, 'linefit')
| mv-expand timestamp to typeof(datetime), caudal_avg to typeof(double),
            anomalies to typeof(int), score to typeof(double)
| where anomalies != 0
| project timestamp, surtidor_id, caudal_avg, score

// 5. Tiempo medio entre fallos (MTBF aproximado) por estación
telemetria_surtidores
| where severidad == "error"
| order by estacion_id asc, timestamp asc
| extend prev_ts = prev(timestamp), prev_est = prev(estacion_id)
| where estacion_id == prev_est
| extend mins_entre_fallos = datetime_diff('minute', timestamp, prev_ts)
| summarize mtbf_min = avg(mins_entre_fallos) by estacion_id
| order by mtbf_min asc

// 6. Estaciones sin telemetría en las últimas 2h (alerta)
let activas = telemetria_surtidores
    | where timestamp > ago(2h)
    | summarize by estacion_id;
telemetria_surtidores
| summarize by estacion_id
| join kind=leftanti activas on estacion_id
| project estacion_id, alerta = "Sin telemetría en 2h"
